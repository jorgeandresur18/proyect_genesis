{
  "name": "proyecto-genesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:routes": "vitest run tests/routes.test.ts",
    "guion:exportar": "node tools/guion.mjs exportar",
    "guion:importar": "node tools/guion.mjs importar",
    "sprites": "node --max-old-space-size=12000 tools/sprites.mjs",
    "fondos": "node tools/fondos.mjs",
    "og": "node tools/og.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "ag-psd": "^22.0.2",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
